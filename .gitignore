data/raw/*
data/processed/*
data/external/*
!data/**/.gitkeep
!data/**/README.md

models/*
!models/.gitkeep
!models/README.md
*.pkl
*.joblib
*.h5
*.keras
*.pt
*.pth
*.bin
*.onnx
*.safetensors
*.model
*.wv
*.npy
wandb/
mlruns/
lightning_logs/

